# Backend (Express API)
DATABASE_URL=postgres://evt:evt@localhost:5432/events
JWT_SECRET=change-me-to-a-secure-random-secret-in-production
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=debug
DB_POOL_SIZE=10

