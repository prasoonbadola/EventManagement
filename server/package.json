    "luxon": "^3.7.2",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.23.15",
